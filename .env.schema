# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public origin used by the browser and Better Auth.
# @required @type=url
VITE_BASE_URL=http://localhost:3000

# PostgreSQL connection URL. Run `docker-compose up -d` for the local database.
# @required @sensitive @type=url
DATABASE_URL=postgresql://postgres:password@localhost:5432/cove

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @required @sensitive
# @docs(https://better-auth.com/docs/reference/environment-variables)
BETTER_AUTH_SECRET=

# Optional GitHub OAuth application credentials.
# @optional
GITHUB_CLIENT_ID=
# @optional @sensitive
GITHUB_CLIENT_SECRET=

# Optional Google OAuth application credentials.
# @optional
GOOGLE_CLIENT_ID=
# @optional @sensitive
GOOGLE_CLIENT_SECRET=

# NOTE:
# For OAuth2 apps, set callback/redirect URIs to`http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/google

# Model provider key for the chat screens. The provider is read off the key's prefix:
# sk-ant- Anthropic, sk-or- OpenRouter, sk- OpenAI, AIza Google, gsk_ Groq, xai- xAI, vck_ Vercel AI Gateway.
# Without a key the chat screens answer with their built-in sample replies.
# @optional @sensitive
AI_API_KEY=
# Names the provider when the key has no recognisable prefix: mistral, deepseek, or custom.
# @optional
AI_PROVIDER=
# Any OpenAI-compatible server (Ollama, LM Studio, vLLM). Requires CHAT_MODEL.
# @optional @type=url
AI_BASE_URL=
# Overrides the provider's default model.
# @optional
CHAT_MODEL=
